---
import BasePage from "../../layouts/BasePage.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { BLOG_TITLE, BLOG_DESCRIPTION } from "../../consts";
import { getBlogs } from "../../content_helper";
import { Image } from "astro:assets";
import RssFeedIcon from "../../assets/icons/rss_feed.svg";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "";

const posts = (await getBlogs()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/blog/*.{jpeg,jpg,png,gif}",
);
---

<BasePage title={BLOG_TITLE} description={BLOG_DESCRIPTION}>
  <div class="mb-8 flex flex-row items-center">
    <h1 class="grow pr-6 text-3xl font-extrabold">{BLOG_TITLE}</h1>
    <a class="group" href="/blog/feed.xml" aria-label="RSS feed">
      <RssFeedIcon
        class="fill-theme-text dark:fill-theme-dark-text transition-colors group-hover:fill-orange-500"
        width={36}
        height={36}
        aria-hidden="true"
      />
    </a>
  </div>
  <section>
    <ul
      class="divide-theme-text/15 dark:divide-theme-dark-text/15 border-theme-text/15 dark:border-theme-dark-text/15 divide-y border-y"
    >
      {
        posts.map((post) => (
          <li>
            <a
              class="group flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:gap-4"
              href={getRelativeLocaleUrl(locale, `/blog/${post.id}/`)}
            >
              <div class="grow">
                <h2 class="group-hover:decoration-theme-primary dark:group-hover:decoration-theme-dark-primary text-xl font-semibold underline decoration-transparent decoration-4 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-theme-text/70 dark:text-theme-dark-text/70 text-sm">
                  <FormattedDate date={post.data.pubDate} />
                </p>
              </div>
              {post.data.heroImage && images[post.data.heroImage] && (
                <Image
                  class="order-first aspect-5/2 w-full shrink-0 rounded-sm object-cover object-center sm:order-none sm:h-[8em] sm:w-[12em]"
                  src={images[post.data.heroImage]()}
                  alt={post.data.heroImageAlt}
                  widths={[384, 768]}
                  sizes="(min-width: 40rem) 12em, 100vw"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BasePage>
