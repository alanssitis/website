---
import { getRelativeLocaleUrl } from "astro:i18n";

import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
let pathname = "/" + Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const hrefstr = href!.toString();

const locale = Astro.currentLocale ?? "";
if (locale && !pathname.startsWith(locale, 1)) {
  pathname = getRelativeLocaleUrl(locale, pathname);
}

const isActive = hrefstr.includes("blog")
  ? pathname.startsWith(hrefstr)
  : pathname == hrefstr;
---

<a
  class:list={[
    className,
    "inline-block text-lg font-semibold underline decoration-4 transition-colors",
    isActive
      ? "decoration-theme-accent dark:decoration-theme-dark-accent font-bold"
      : "hover:decoration-theme-text/30 dark:hover:decoration-theme-dark-text/30 decoration-transparent",
  ]}
  href={href}
  {...props}
>
  <slot />
</a>
